# Microsoft Azure AI Foundry & Azure Health Data Services Configuration
# RespiSense AI / NightDoc - Bedside Acoustic Biomarker Sentinel

# Azure AI Services / Foundry Endpoint & Key
AZURE_AI_API_KEY=your_actual_azure_api_key_here
AZURE_AI_ENDPOINT=https://<your-azure-ai-resource>.cognitiveservices.azure.com/
AZURE_AI_REGION=eastus

# Azure OpenAI / Azure AI Model Deployment (for clinical report synthesis)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure Cognitive Speech (for bedside patient speech transcription)
AZURE_SPEECH_LANGUAGE=ro-RO

# Azure Health Data Services (FHIR Server Endpoint)
AZURE_FHIR_ENDPOINT=https://your-workgroup.fhir.azurehealthcareapis.com
